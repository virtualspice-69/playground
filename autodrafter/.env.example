# Copy to .env or export these before running `npm run serve`.

# Required for real drafts (photos analyzed by Claude). Get one at platform.claude.com
ANTHROPIC_API_KEY=

# Optional: model override (default claude-opus-4-8)
AUTODRAFT_MODEL=

# Optional: enable the Google Photos / Google Drive buttons.
# Create a free OAuth app at console.cloud.google.com — see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: port (default 3000)
PORT=
