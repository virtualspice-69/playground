# --- Required ---
# Get this from @BotFather on Telegram (New Bot -> copy token)
BOT_TOKEN=

# Your token's contract address (any chain DexScreener indexes). This is how
# /price works without hardcoding a specific chain or exchange name.
TOKEN_CONTRACT_ADDRESS=

# --- Branding ---
TOKEN_TICKER=IF
TOKEN_NAME=What If

# Optional: force a specific DexScreener pair address if your token has many
# pairs and you want /price to always show a specific one (e.g. the main
# Uniswap pool). Leave blank to auto-pick the highest-liquidity pair.
DEXSCREENER_PAIR_ADDRESS=

# --- Links shown in /start, /buy, /links ---
WEBSITE_URL=
TWITTER_URL=
TELEGRAM_GROUP_URL=
UNISWAP_BUY_URL=
BLOFIN_URL=

# --- AI art generation (free, no key needed by default) ---
# Pollinations.ai is used for /art and /variations. Free tier, no API key
# required. Leave as-is unless you switch providers later.
IMAGE_GEN_PROVIDER=pollinations

# FLUX is the current best open-weights image model (much better anatomy and
# hands than older SDXL-class models). Use "turbo" for speed, "flux" for quality.
IMAGE_GEN_MODEL=flux

# CHARACTER_PROMPT / NEGATIVE_PROMPT / IMAGE_GEN_STYLE_SUFFIX all have tuned
# defaults in config.py. Leave them commented out to use those defaults —
# only uncomment and set them here once you've locked in a look you prefer
# via scripts/art_lab.py.
#
# CHARACTER_PROMPT=
# NEGATIVE_PROMPT=
# IMAGE_GEN_STYLE_SUFFIX=

# --- Anti-spam ---
# Seconds a user must wait between /art, /variations, or /meme requests.
COMMAND_COOLDOWN_SECONDS=8
