# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file. It is already listed in .gitignore.

# --- Kraken Pro API credentials ---
# Create at: Kraken -> Settings -> API -> Add key
# Required permissions: Query Funds, Query Open Orders & Trades,
#   Create & Modify Orders, Cancel/Close Orders.
# Do NOT grant "Withdraw Funds" to this key.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Optional: liquidation heatmap data source (e.g. Coinglass) ---
# Leave blank to run without heatmap input; the strategy will treat
# the liquidation signal as neutral rather than fail.
LIQUIDATION_HEATMAP_API_KEY=
LIQUIDATION_HEATMAP_PROVIDER=none   # none | coinglass

# --- Trading agent configuration ---
# Trading pairs to trade, comma separated, in ccxt/Kraken symbol form.
TRADING_SYMBOLS=BTC/USD,ETH/USD

# Candle timeframe used for indicator calculation.
TIMEFRAME=15m

# DRY_RUN=true means the agent computes signals and logs the orders it
# WOULD place, but never calls the exchange's order-creation endpoint.
# Flip to false only after you have reviewed dry-run logs and accept
# the risk of live capital. This is the single master safety switch.
DRY_RUN=true

# --- Risk parameters ---
# Max % of account equity allowed to be lost in a single UTC day before
# the agent halts new entries (existing positions may still be closed).
MAX_DAILY_DRAWDOWN_PCT=2.0

# Max % of account equity committed to any single open position.
MAX_POSITION_SIZE_PCT=5.0

# Max number of concurrent open positions across all symbols.
MAX_CONCURRENT_POSITIONS=3

# Per-trade protective levels, as a percent move against/for the entry.
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3.0

# Minimum composite confluence score (0-1) required before a signal
# is allowed to become an order. Kept high by design.
MIN_SIGNAL_CONFIDENCE=0.8

# Seconds between polling cycles when running the continuous loop.
POLL_INTERVAL_SECONDS=60
